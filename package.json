{
  "name": "ssh-host-colors",
  "displayName": "Host Colors — SSH, WSL, Containers & Folders",
  "description": "%description%",
  "version": "0.3.0",
  "publisher": "lcs-jd",
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e2129",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lcs-jd/ssh-host-colors.git"
  },
  "bugs": {
    "url": "https://github.com/lcs-jd/ssh-host-colors/issues"
  },
  "homepage": "https://github.com/lcs-jd/ssh-host-colors#readme",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Themes"
  ],
  "keywords": [
    "ssh",
    "remote",
    "remote-ssh",
    "wsl",
    "devcontainer",
    "dev-container",
    "container",
    "docker",
    "codespaces",
    "tunnel",
    "server",
    "host",
    "folder",
    "project",
    "workspace",
    "environment",
    "production",
    "color",
    "colour",
    "titlebar",
    "statusbar",
    "window",
    "peacock"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "sshHostColors.openManager",
        "title": "%command.openManager%",
        "category": "Host Colors",
        "icon": "$(symbol-color)"
      },
      {
        "command": "sshHostColors.setColor",
        "title": "%command.setColor%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.configureZones",
        "title": "%command.configureZones%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.toggle",
        "title": "%command.toggle%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.removeColor",
        "title": "%command.removeColor%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.removeAll",
        "title": "%command.removeAll%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.cleanWorkspace",
        "title": "%command.cleanWorkspace%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.refresh",
        "title": "%command.refresh%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.export",
        "title": "%command.export%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.import",
        "title": "%command.import%",
        "category": "Host Colors"
      },
      {
        "command": "sshHostColors.menu",
        "title": "%command.menu%",
        "category": "Host Colors"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sshHostColors.menu",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Host Colors",
      "properties": {
        "sshHostColors.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.enabled%",
          "scope": "application"
        },
        "sshHostColors.hosts": {
          "type": "object",
          "default": {},
          "scope": "application",
          "markdownDescription": "%config.hosts%",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
              },
              {
                "type": "object",
                "required": [
                  "color"
                ],
                "properties": {
                  "color": {
                    "type": "string",
                    "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
                  },
                  "label": {
                    "type": "string",
                    "description": "%config.hosts.label%"
                  },
                  "elements": {
                    "type": "array",
                    "uniqueItems": true,
                    "description": "%config.hosts.elements%",
                    "items": {
                      "type": "string",
                      "enum": [
                        "titleBar",
                        "commandCenter",
                        "activityBar",
                        "statusBar",
                        "remoteIndicator",
                        "activeTab",
                        "sideBarBorder",
                        "panelBorder",
                        "windowBorder"
                      ]
                    }
                  }
                }
              }
            ]
          }
        },
        "sshHostColors.elements": {
          "type": "array",
          "default": [
            "titleBar",
            "activityBar",
            "statusBar"
          ],
          "uniqueItems": true,
          "description": "%config.elements%",
          "scope": "application",
          "items": {
            "type": "string",
            "enum": [
              "titleBar",
              "commandCenter",
              "activityBar",
              "statusBar",
              "remoteIndicator",
              "activeTab",
              "sideBarBorder",
              "panelBorder",
              "windowBorder"
            ],
            "enumDescriptions": [
              "%zone.titleBar%",
              "%zone.commandCenter%",
              "%zone.activityBar%",
              "%zone.statusBar%",
              "%zone.remoteIndicator%",
              "%zone.activeTab%",
              "%zone.sideBarBorder%",
              "%zone.panelBorder%",
              "%zone.windowBorder%"
            ]
          }
        },
        "sshHostColors.showStatusBarItem": {
          "type": "boolean",
          "default": true,
          "description": "%config.showStatusBarItem%",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package",
    "publish": "npx --yes @vscode/vsce publish"
  }
}
